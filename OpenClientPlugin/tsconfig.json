{
  "$schema": "https://json.schemastore.org/tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "bun",
      "node"
    ]
  },
  "include": [
    "src"
  ]
}
